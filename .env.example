# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# HubSpot Private App token (Settings → Integrations → Private Apps)
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Optional filters — leave blank to run all 64 queries
# ---------------------------------------------------------------------------

# Industries to target (comma-separated, lowercase)
# Valid values: saas, fintech, healthcare, ecommerce, real-estate,
#               consulting, agency, technology, enterprise,
#               cybersecurity, logistics, hr
# Example: FILTER_INDUSTRIES=saas,fintech,agency
FILTER_INDUSTRIES=

# Locations to target (comma-separated, lowercase)
# Valid values: australia, uk, us, canada, germany, netherlands
# Example: FILTER_LOCATIONS=australia,uk
FILTER_LOCATIONS=
